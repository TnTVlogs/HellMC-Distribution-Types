{
  "name": "hellmc-distribution-types",
  "version": "1.0.0",
  "description": "TypeScript types for the HellMC distribution.json (v2) format. Independent implementation of the Helios distribution specification.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "tsc": "tsc",
    "build": "npm run clean && npm run tsc",
    "prepare": "npm run build",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TnTVlogs/HellMC-Distribution-Types.git"
  },
  "keywords": [
    "hellmc",
    "distribution",
    "types"
  ],
  "author": "TnTVlogs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TnTVlogs/HellMC-Distribution-Types/issues"
  },
  "homepage": "https://github.com/TnTVlogs/HellMC-Distribution-Types#readme",
  "devDependencies": {
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@types/node": "^22.19.3",
    "eslint": "^9.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.9.0"
  }
}
